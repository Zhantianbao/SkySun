FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && useradd --create-home --shell /usr/sbin/nologin skysun \
    && chown -R skysun:skysun /app

USER skysun

EXPOSE 8000
CMD ["uvicorn", "skysun.core.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
